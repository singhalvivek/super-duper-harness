# Meeting Capture Assistant — environment configuration
# Copy this file to `.env` and fill in the values. `.env` is gitignored; never commit real secrets.

# --- Google Gemini (REQUIRED) ---------------------------------------------
# API key for Google Gemini (via the @google/genai SDK). Used to auto-title
# captured meetings (Phase 1) and later to summarize / answer questions.
# Get a key at https://aistudio.google.com/apikey
# NOTE: the key is NOT validated for the usual `AIza…` shape — any key is sent
# to the provider as-is; an auth failure surfaces a clear, actionable error.
GEMINI_API_KEY=

# Gemini model id (OPTIONAL — defaults to gemini-2.5-flash).
# gemini-2.5-flash has a ~1M-token input window, ample for 1–2h transcripts.
# GEMINI_MODEL=gemini-2.5-flash

# --- Database (OPTIONAL) ---------------------------------------------------
# Local SQLite file path for the meeting library. Defaults to
# packages/web/data/meetings.db (the data/ dir is gitignored). Override to
# relocate the DB file.
# DATABASE_URL=./data/meetings.db

# --- Slack (OPTIONAL — used in a later phase) ------------------------------
# Incoming Webhook URL to auto-post meeting summaries. Leave blank until the
# Slack phase; when blank the Slack step is skipped silently.
SLACK_WEBHOOK_URL=
