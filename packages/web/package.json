{
  "name": "@meeting-capture/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Meeting Capture Assistant web app — Next.js 15 dashboard UI + /api/* Route Handlers (one app, one port). Persists captured Google Meet sessions to SQLite and auto-titles them via Google Gemini.",
  "scripts": {
    "dev": "next dev -p 8788",
    "build": "next build",
    "start": "next start -p 8788",
    "test": "vitest run",
    "test:e2e": "playwright test tests/e2e/ --reporter=line",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.10.0",
    "@libsql/client": "^0.14.0",
    "@meeting-capture/shared": "workspace:*",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.36.4",
    "next": "^15.1.3",
    "pino": "^9.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "drizzle-kit": "^0.28.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
